# name: corpus/slt/subquery_over_a_grouped_query.test
# description: a subquery written in a clause of a grouped query, which is one row for the whole query
# group: [subquery]

# A subquery in a select list, a HAVING or an ORDER BY of a grouped query is evaluated once for the
# whole query when it is uncorrelated, so it is not a value that varies within a group and it needs
# no group of its own. The grouping rule is about columns of the query's own FROM and this is not
# one of those.
#
# What made this a file rather than one record is where its join goes. Underneath the grouping its
# column is a column of every row going into the aggregate, which the grouping rule then asks for in
# the GROUP BY, and the aggregate carries nothing but its groups and its aggregates upward, so the
# projection could not read the column even if the rule let it through. Over the grouping both
# problems go away, and there is a record per shape here because each shape reaches the lifting by a
# different route: a scalar query, a mark join, an existence test, a clause that is not the select
# list, and the one shape that must stay underneath.
#
# Every expectation was taken off the pinned DuckDB and not out of rudb.

statement ok
CREATE TABLE lift_outer (k INTEGER, t VARCHAR);

statement ok
CREATE TABLE lift_inner (k INTEGER, w INTEGER, s VARCHAR);

statement ok
INSERT INTO lift_outer VALUES (1, 'a'), (2, 'b'), (3, NULL), (NULL, 'd');

statement ok
INSERT INTO lift_inner VALUES (1, 100, 'x'), (1, 200, 'y'), (2, 300, 'x'), (NULL, 400, 'z');

# The smallest shape. There is no GROUP BY at all, so the aggregate is one row, and the subquery is
# the other column of it.

query II
SELECT max(w), (SELECT 1) FROM lift_inner;
----
400	1

# The same beside a group key, so there is a row per group and every one of them reads the same
# value.

query II
SELECT k, (SELECT 1) FROM lift_inner GROUP BY k ORDER BY k;
----
1	1
2	1
NULL	1

# Inside an expression rather than as the whole target, on both sides of the operator, because the
# walk that rewrites an expression over the aggregate recurses and the two sides are two different
# arms of it.

query II
SELECT max(w) + (SELECT 1), (SELECT 1) + max(w) FROM lift_inner;
----
401	401

# The subquery reads the same table the query groups. Joined underneath, this is the shape that
# would have multiplied the rows going into the aggregate as well as losing the column, so the count
# is the part worth reading here.

query II
SELECT count(*), (SELECT max(w) FROM lift_inner) FROM lift_inner;
----
4	400

# An IN binds as a mark join, which carries its comparison rather than the expression carrying it,
# and that comparison is written over the outer rows. So the comparison needs the same rewrite the
# expression gets, and its left side here is an aggregate.

query IT
SELECT s, max(w) IN (SELECT w FROM lift_inner WHERE w > 250) FROM lift_inner GROUP BY s ORDER BY s;
----
x	true
y	false
z	true

# An EXISTS is a third shape again, a marker column joined in and then compared against NULL.

query IT
SELECT k, EXISTS (SELECT 1 FROM lift_outer WHERE lift_outer.t = 'a') FROM lift_inner GROUP BY k ORDER BY k;
----
1	true
2	true
NULL	true

# Sorted on a query nothing selects, so the key is projected as an extra column and dropped again,
# and the query it reads still has to be joined over the grouping.

query I
SELECT k FROM lift_inner GROUP BY k ORDER BY (SELECT 1), k;
----
1
2
NULL

# A select list and a HAVING each writing one, which is the record that says the two clauses put
# their queries on the same list rather than each on its own.

query III
SELECT k, (SELECT 1), sum(w) FROM lift_inner GROUP BY k HAVING sum(w) > (SELECT 250) ORDER BY k;
----
1	1	300
2	1	300
NULL	1	400

# A grouped query inside a grouped query, each with one of its own to lift. The inner one finishes
# first, so an engine that left the outer one's list where the inner one could clear it would lose
# it.

query II
SELECT k, (SELECT 1) FROM lift_inner WHERE w IN (SELECT max(w) FROM lift_inner GROUP BY k HAVING max(w) > (SELECT 150)) GROUP BY k ORDER BY k;
----
1	1
2	1
NULL	1

# Grouped by the subquery itself, through the alias it was given. The group is one value, so there
# is one row.

query II
SELECT (SELECT 42) AS c, max(w) FROM lift_inner GROUP BY c;
----
42	400

# SELECT DISTINCT over a lifted one, where the groups all read the same value and collapse back to a
# single row.

query I
SELECT DISTINCT (SELECT 1) FROM lift_inner GROUP BY k;
----
1

# The one shape that must not be lifted. A query written inside the aggregate's own argument is read
# once per row going into the aggregate, so over the grouping is exactly where the aggregate that
# reads it cannot see it.

query II
SELECT k, max((SELECT 42)) FROM lift_inner GROUP BY k ORDER BY k;
----
1	42
2	42
NULL	42

# A correlated one is lifted too, as of rudb #1032. The correlation is on the group key, so the value
# is one per group and there is an answer, and what used to be missing was a rewrite of the reference
# inside the subquery from the table underneath the grouping to the group itself. This record was a
# refusal until that landed.

query II
SELECT k, (SELECT max(t) FROM lift_outer WHERE lift_outer.k = lift_inner.k) FROM lift_inner GROUP BY k ORDER BY k;
----
1	a
2	b
NULL	NULL
