# name: corpus/slt/exists_subquery.test
# description: EXISTS and NOT EXISTS match the pinned engine
# group: [smoke]

query I
SELECT EXISTS (SELECT 1);
----
1

query I
SELECT EXISTS (SELECT 1 WHERE false);
----
0

query I
SELECT NOT EXISTS (SELECT 1 WHERE false);
----
1

query I
SELECT EXISTS (SELECT NULL FROM range(2));
----
1

query I rowsort
SELECT x FROM (VALUES (1), (2)) t(x) WHERE EXISTS (SELECT 1);
----
1
2

query I
SELECT x FROM (VALUES (1), (2)) t(x) WHERE EXISTS (SELECT 1 WHERE false);
----

query I
SELECT EXISTS (SELECT EXISTS (SELECT 1));
----
1

query I rowsort
SELECT k FROM (VALUES (1), (2), (3), (NULL)) o(k) WHERE EXISTS (SELECT 1 FROM (VALUES (1), (1), (3), (NULL)) i(k) WHERE i.k = o.k);
----
1
3

query I rowsort
SELECT k FROM (VALUES (1), (2), (3)) o(k) WHERE NOT EXISTS (SELECT 1 FROM (VALUES (1, 5), (2, 20)) i(k, value) WHERE i.k = o.k AND value > 10);
----
1
3
