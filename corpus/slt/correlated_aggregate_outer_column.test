# name: corpus/slt/correlated_aggregate_outer_column.test
# description: a subquery that aggregates and also reads a column of the query above it
# group: [subquery]

# The grouping rule is about columns of the query's own FROM. A name that resolved past it to an
# enclosing query is not one of those, because the subquery is evaluated once per outer row and such
# a name is one value for the whole of it. So it needs no group of its own and belongs wherever a
# grouped column belongs, in the select list, in a HAVING, and beside an aggregate.
#
# The other half of this is where the outer column ends up in the plan. A rule that moves the
# projection onto the right side of an ordinary join puts it somewhere a column of the left side is
# not in scope, so either the rule stands aside or it carries the outer column across as a domain
# key. Both halves were wrong at once, which is why this file has a record for each shape rather
# than one for the smallest of them.
#
# Every expectation was taken off the pinned DuckDB and not out of rudb.

statement ok
CREATE TABLE agg_outer (k INTEGER, t VARCHAR);

statement ok
CREATE TABLE agg_inner (k INTEGER, w INTEGER, s VARCHAR);

statement ok
INSERT INTO agg_outer VALUES (1, 'a'), (2, 'b'), (3, NULL), (NULL, 'd');

statement ok
INSERT INTO agg_inner VALUES (1, 100, 'x'), (1, 200, 'y'), (2, 300, 'x'), (NULL, 400, 'z');

# The smallest shape. The outer column sits beside an aggregate in the select list and the subquery
# is correlated through its WHERE. The two outer rows with no matching inner row get NULL, because
# an aggregate over no rows is NULL and NULL plus anything is NULL.

query II
SELECT k, (SELECT max(w) + o.k FROM agg_inner i WHERE i.k = o.k) AS c FROM agg_outer o ORDER BY k;
----
1	201
2	302
3	NULL
NULL	NULL

# The outer column on its own with nothing else in the projection, over a GROUP BY. The group is
# what makes it at most one row, and the value is the outer row's own, not the group's.

query II
SELECT k, (SELECT o.k FROM agg_inner i WHERE i.k = o.k GROUP BY i.k) AS c FROM agg_outer o ORDER BY k;
----
1	1
2	2
3	NULL
NULL	NULL

# The same select list with nothing correlating the subquery's body. Every outer row reads the same
# aggregate, so only the row whose k is NULL is NULL, and k of 3 gets an answer here where it got
# NULL above.

query II
SELECT k, (SELECT max(w) + o.k FROM agg_inner i) AS c FROM agg_outer o ORDER BY k;
----
1	401
2	402
3	403
NULL	NULL

# The outer column in a HAVING. This is the shape that hid, because a HAVING binds as a filter above
# the subquery's aggregate and the correlated filter the query really has is two nodes further down.

query II
SELECT k, (SELECT max(w) FROM agg_inner i WHERE i.k = o.k HAVING max(w) > o.k) AS c FROM agg_outer o ORDER BY k;
----
1	200
2	300
3	NULL
NULL	NULL

# A HAVING over a count rather than over the aggregate being selected, so the outer column is
# compared against something the projection does not read. Only the first outer row passes.

query II
SELECT k, (SELECT max(w) FROM agg_inner i WHERE i.k = o.k HAVING count(*) > o.k) AS c FROM agg_outer o ORDER BY k;
----
1	200
2	NULL
3	NULL
NULL	NULL

# The outer column inside the aggregate's argument instead of beside it. This one always worked and
# is here as the control, since it is the same answer as the first record and reaches it by a
# different route.

query II
SELECT k, (SELECT max(w + o.k) FROM agg_inner i WHERE i.k = o.k) AS c FROM agg_outer o ORDER BY k;
----
1	201
2	302
3	NULL
NULL	NULL

# The outer column read both inside an aggregate and outside it in the same projection, so it has to
# be available in both places at once.

query II
SELECT k, (SELECT max(i.w + o.k) + o.k FROM agg_inner i WHERE i.k = o.k) AS c FROM agg_outer o ORDER BY k;
----
1	202
2	304
3	NULL
NULL	NULL

# Beside an aggregate over a GROUP BY on the correlated column, which is the shape where the outer
# column has to become a domain key and the projection has to be pointed at the group.

query II
SELECT k, (SELECT min(w) + o.k FROM agg_inner i WHERE i.k = o.k GROUP BY i.k) AS c FROM agg_outer o ORDER BY k;
----
1	101
2	302
3	NULL
NULL	NULL

# A VARCHAR outer column over the same GROUP BY, so the domain key is not an integer. The third
# outer row has no group at all and the fourth has a t of 'd' that never gets read.

query II
SELECT k, (SELECT o.t FROM agg_inner i WHERE i.k = o.k GROUP BY i.k) AS c FROM agg_outer o ORDER BY k;
----
1	a
2	b
3	NULL
NULL	NULL

# Beside a count, where an outer row with no matching inner row gets a count of zero rather than
# NULL, so the answer is the outer column itself and not NULL.

query II
SELECT k, (SELECT count(*) + o.k FROM agg_inner i WHERE i.k = o.k) AS c FROM agg_outer o ORDER BY k;
----
1	3
2	3
3	3
NULL	NULL

# A GROUP BY on the outer column with an aggregate over the inner table. The group is one value for
# the whole subquery, so the outer rows that match an inner row get one row back. The two that match
# nothing are left out, because a grouped max over no rows is no group rather than a NULL one.

query II
SELECT k, (SELECT max(w) FROM agg_inner i WHERE i.k = o.k GROUP BY o.t) AS c FROM agg_outer o ORDER BY k;
----
1	200
2	300
3	NULL
NULL	NULL

# The same with a count, which is the shape that has an answer either way and so needs saying out
# loud. A scalar count over an empty input is zero, which is why the unnesting keeps a padded row
# for an outer key nothing matched, but a count over no groups is no row and a scalar subquery that
# returns no row is NULL. The group here is written on the outer column, so the padded row takes the
# outer value and the invented group looks exactly like a real one.

query II
SELECT k, (SELECT count(*) FROM agg_inner i WHERE i.k = o.k GROUP BY o.t) AS c FROM agg_outer o ORDER BY k;
----
1	2
2	1
3	NULL
NULL	NULL

# The same count grouped on the inner column instead.

query II
SELECT k, (SELECT count(*) FROM agg_inner i WHERE i.k = o.k GROUP BY i.k) AS c FROM agg_outer o ORDER BY k;
----
1	2
2	1
3	NULL
NULL	NULL

# Beside an aggregate whose body filters on something other than the outer row, so the subquery is
# correlated only through the projection and nowhere else.

query II
SELECT k, (SELECT sum(w) * o.k FROM agg_inner i WHERE i.w > 150) AS c FROM agg_outer o ORDER BY k;
----
1	900
2	1800
3	2700
NULL	NULL

# The same, over a GROUP BY on a column the outer row has nothing to do with.

query II
SELECT k, (SELECT max(w) + o.k FROM agg_inner i WHERE i.s = 'x' GROUP BY i.s) AS c FROM agg_outer o ORDER BY k;
----
1	301
2	302
3	303
NULL	NULL

# A correlated filter with a second condition beside it, so the inner rows the aggregate sees are a
# subset of the group and the first outer row's answer moves.

query II
SELECT k, (SELECT max(w) + o.k FROM agg_inner i WHERE i.k = o.k AND i.w > 100) AS c FROM agg_outer o ORDER BY k;
----
1	201
2	302
3	NULL
NULL	NULL

# The same subquery in a WHERE rather than in a select list, which is a different position in the
# plan for the same correlation. No outer row passes, and an engine that dropped the outer column
# would let some through.

query I
SELECT k FROM agg_outer o WHERE k > (SELECT avg(w) - o.k FROM agg_inner i WHERE i.k = o.k) ORDER BY k;
----

# A column of the subquery's own FROM that is neither grouped nor aggregated is still refused, and
# the message names it. Letting the outer column through is not the same as letting every column
# through, and this record is the line between the two.

statement error
SELECT k, (SELECT i.s FROM agg_inner i WHERE i.k = o.k GROUP BY i.k) AS c FROM agg_outer o;
----
column "s" must appear in the GROUP BY clause
