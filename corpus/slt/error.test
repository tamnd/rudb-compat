# name: corpus/slt/error.test
# description: the error classes E0 ships, with the message upstream prints where both agree on it
# group: [smoke]

# An error is an answer. A query that should fail and instead returns rows is as wrong as a query
# that returns the wrong rows, and a query that fails with the wrong kind sends whoever reads the
# message looking in the wrong place. So the classes below are pinned the same way a result set is.
#
# Every expectation here was taken off the pinned DuckDB and not out of rudb, one statement per
# process through both shells. Where the two engines print the same sentence the whole sentence is
# written down, because that is the thing worth holding still. Where they do not yet agree the
# record keeps only the part they share and a comment says what upstream prints instead, so the
# file stays a gate rudb passes today without quietly agreeing that rudb's wording is the right one.

statement ok
CREATE TABLE t (a INTEGER, b VARCHAR);

statement ok
INSERT INTO t VALUES (1, 'one'), (2, 'two');

# The parser, which is the first thing that can say no.

statement error
SELECT FROM WHERE;
----
Parser Error: syntax error at or near "WHERE"

statement error
SELECT ('unterminated;
----
Parser Error: unterminated string literal

# The catalog, which is the second.

statement error
SELECT * FROM nosuchtable;
----
Catalog Error: Table with name nosuchtable does not exist!

statement error
DROP TABLE nosuchtable;
----
Catalog Error: Table with name nosuchtable does not exist!

statement error
CREATE TABLE t (a INTEGER);
----
Catalog Error: Table with name "t" already exists!

statement error
SELECT nosuchfunction(1);
----
Catalog Error: Scalar Function with name nosuchfunction does not exist!

# The binder. A name that is not there is the common one, and it has to come out the same wherever
# in the statement the name was written, so it is pinned from three clauses.

statement error
SELECT nosuchcolumn FROM t;
----
Binder Error: Referenced column "nosuchcolumn" not found in FROM clause!

statement error
SELECT * FROM t WHERE nosuchcolumn = 1;
----
Binder Error: Referenced column "nosuchcolumn" not found in FROM clause!

statement error
SELECT a FROM t ORDER BY nosuchcolumn;
----
Binder Error: Referenced column "nosuchcolumn" not found in FROM clause!

# Upstream ends this one at the exclamation mark and puts the candidate tables on the next line.
# rudb writes "not found in FROM clause!" instead, so only the part before it is recorded.
statement error
SELECT nosuchtable.a FROM t;
----
Binder Error: Referenced table "nosuchtable" not found

# Upstream quotes the two suggestions with apostrophes and rudb quotes them with double quotes, so
# the record stops before them.
statement error
SELECT a FROM t, t AS u;
----
Binder Error: Ambiguous reference to column name "a"

# Upstream ends this sentence with a full stop and rudb does not.
statement error
SELECT a, b FROM t GROUP BY a;
----
Binder Error: column "b" must appear in the GROUP BY clause or must be part of an aggregate function

statement error
SELECT 1 UNION ALL SELECT 1, 2;
----
Binder Error: Set operations can only apply to expressions with the same number of result columns

statement error
SELECT * FROM (SELECT 1) AS x(a, b);
----
Binder Error: table "x" has 1 columns available but 2 columns specified

statement error
INSERT INTO t VALUES (1, 'one', 'extra');
----
has 2 columns but 3 values were supplied

# A function that exists and was called with types it has no signature for. The candidate list is
# part of the message on both sides, which is the part that makes the error useful, so it is pinned
# as well.
statement error
SELECT sum(b) FROM t;
----
Binder Error: No function matches the given name and argument types 'sum(VARCHAR)'. You might need to add explicit type casts.

# Upstream calls an integer literal INTEGER_LITERAL here and rudb calls it INTEGER, so the argument
# types are left out and the candidate list is not.
statement error
SELECT strlen(1, 2);
----
Binder Error: No function matches the given name and argument types 'strlen(
Candidate functions:
strlen(col0 VARCHAR) -> BIGINT

# The casts that cannot be done, one per shape of failure, whole sentence pinned. This was the one
# entry in this file cut back to a fragment, because rudb said two sentences where upstream says
# eight, and rudb#322 closed the gap. The type names in them are the physical ones, which is why
# none of them say INTEGER or TINYINT, and the decimal ones name the integer the decimal is stored
# in rather than the width it was declared with.
statement error
SELECT 'abc'::INTEGER;
----
Conversion Error: Could not convert string 'abc' to INT32

statement error
SELECT '300'::TINYINT;
----
Conversion Error: Could not convert string '300' to INT8

statement error
SELECT 'abc'::DECIMAL(4,1);
----
Conversion Error: Could not convert string "abc" to DECIMAL(4,1)

statement error
SELECT 300::INTEGER::TINYINT;
----
Conversion Error: Type INT32 with value 300 can't be cast because the value is out of range for the destination type INT8

statement error
SELECT 999.9::DECIMAL(4,1)::TINYINT;
----
Conversion Error: Failed to cast decimal value 1000 to type INT8

statement error
SELECT 200000::DECIMAL(4,1);
----
Conversion Error: Could not cast value 200000 to DECIMAL(4,1)

statement error
SELECT 200000.5::DECIMAL(7,1)::DECIMAL(4,1);
----
Conversion Error: Casting value "200000.5" to type DECIMAL(4,1) failed: value is out of range!

# A pair with no cast between it is a conversion error and not a missing feature, which is what
# makes TRY_CAST answer null for it rather than raising.
statement error
SELECT DATE '1970-01-01'::INTEGER;
----
Conversion Error: Unimplemented type for cast (DATE -> INTEGER)

query T
SELECT TRY_CAST(DATE '1970-01-01' AS INTEGER);
----
NULL

# A written date, which fails two different ways. A day that is spelled wrong is the format one and
# a day that does not exist is the range one, and the thirty first of April used to come back from
# rudb as the first of May.
statement error
SELECT 'yesterday'::DATE;
----
Conversion Error: invalid date field format: "yesterday", expected format is (YYYY-MM-DD)

statement error
SELECT '2021-04-31'::DATE;
----
Conversion Error: date field value out of range: "2021-04-31"

statement error
SELECT '2021-02-29 10:00:00'::TIMESTAMP;
----
Conversion Error: timestamp field value out of range: "2021-02-29 10:00:00"

statement error
SELECT 'abc'::TIMESTAMP;
----
Conversion Error: invalid timestamp field format: "abc", expected format is (YYYY-MM-DD HH:MM[:SS[.US]][±HH[:MM[:SS]]| ZONE])

# The zone on the end of a written timestamp, which is read to check it and then thrown away because
# a TIMESTAMP has nowhere to keep one. A sign that starts an offset and does not finish one is the
# third sentence a timestamp has and a date has no such sentence, so the same string says the format.

query T
SELECT '2020-01-01 10:00:00+05:30'::TIMESTAMP;
----
2020-01-01 10:00:00

query T
SELECT '2020-01-01 10:00:00 Asia/Ho_Chi_Minh'::TIMESTAMP;
----
2020-01-01 10:00:00

statement error
SELECT '2020-01-01 10:00:00+5'::TIMESTAMP;
----
Conversion Error: timestamp field value "2020-01-01 10:00:00+5" has a timestamp that is not UTC.

statement error
SELECT '2020-01-01 10:00:00+5'::DATE;
----
Conversion Error: invalid date field format: "2020-01-01 10:00:00+5", expected format is (YYYY-MM-DD)

statement error
SELECT '2020-01-01 10:00:00 UTC junk'::TIMESTAMP;
----
Conversion Error: invalid timestamp field format: "2020-01-01 10:00:00 UTC junk", expected format is (YYYY-MM-DD HH:MM[:SS[.US]][±HH[:MM[:SS]]| ZONE])

# A written time is read by a parser of its own, which has one sentence and a lot more slack. The
# slack stops at the day: a bare clock ignores what follows it and a clock with a date in front of it
# is read the way a timestamp is read, which is why the second of these two is refused.

query T
SELECT '12:34:56 zzz junk'::TIME;
----
12:34:56

statement error
SELECT '2020-01-01 12:34:56 zzz junk'::TIME;
----
Conversion Error: time field value out of range: "2020-01-01 12:34:56 zzz junk", expected format is ([YYYY-MM-DD ]HH:MM:SS[.MS])

# And the same day tells the two parsers apart the other way. A bare clock keeps the end of the day
# it was written as, and a clock with a day in front of it is a timestamp first, so it comes back as
# the midnight the second of January starts with.

query T
SELECT '24:00:00'::TIME;
----
24:00:00

query T
SELECT '2020-01-01 24:00:00'::TIME;
----
00:00:00

# A date takes a time on the end and throws it away, and midnight at the end of the day is a time on
# both sides. The date keeps the day it was written with and the timestamp rolls into the next one.
query T
SELECT '2020-02-29 10:30:00'::DATE;
----
2020-02-29

query T
SELECT '2020-01-01 24:00:00'::DATE;
----
2020-01-01

query T
SELECT '2020-01-01 24:00:00'::TIMESTAMP;
----
2020-01-02 00:00:00

# Arithmetic that leaves the type, which is an error and not a wrap.

statement error
SELECT 2147483647::INTEGER + 1::INTEGER;
----
Out of Range Error: Overflow in addition of INT32 (2147483647 + 1)!

statement error
SELECT 9223372036854775807::BIGINT + 1::BIGINT;
----
Out of Range Error: Overflow in addition of INT64 (9223372036854775807 + 1)!

# Division by zero, where the rule is not the one most engines have. Plain division is floating
# point and gives infinity, and it is the integer division and the modulo that raise.

query R
SELECT 1 / 0;
----
inf

statement error
SELECT 1 // 0;
----
Invalid Input Error: Division by zero in expression (1 // 0). Use TRY(...) to return NULL for this expression, or SET null_on_division_by_zero=true to return NULL for all divisions by zero.

statement error
SELECT 1 % 0;
----
Invalid Input Error: Division by zero in expression (1 % 0). Use TRY(...) to return NULL for this expression, or SET null_on_division_by_zero=true to return NULL for all divisions by zero.

# A file that is not there, through both readers and through the replacement scan. The pattern is
# quoted in the message and the path is the one that was asked for, which is what somebody staring
# at a typo needs to see.

statement error
SELECT * FROM read_parquet('corpus/data/nosuchfile.parquet');
----
IO Error: No files found that match the pattern "corpus/data/nosuchfile.parquet"

statement error
SELECT * FROM read_csv('corpus/data/nosuchfile.csv');
----
IO Error: No files found that match the pattern "corpus/data/nosuchfile.csv"

statement error
SELECT * FROM 'corpus/data/nosuchfile.parquet';
----
IO Error: No files found that match the pattern "corpus/data/nosuchfile.parquet"

# The table is still there and still readable after all of that, which is the other half of the
# claim: an error ends the statement and not the session.

query IT
SELECT a, b FROM t ORDER BY a;
----
1	one
2	two

statement ok
DROP TABLE t;
