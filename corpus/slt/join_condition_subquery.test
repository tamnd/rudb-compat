# name: corpus/slt/join_condition_subquery.test
# description: a subquery written in a join's ON, in the shapes that have a plan
# group: [join]

# A query written in a WHERE or a SELECT is evaluated over the rows the whole FROM produced, which
# is above every join in it. A query written in an ON cannot be. The condition it feeds is evaluated
# by the join, over the rows the join's two inputs handed it, so the query has to be evaluated
# underneath, in whichever of those two inputs produces the rows it reads.
#
# That makes the side the query reads the thing worth holding still, so the records below are
# grouped by it: neither side, the left, the right, and then the same over each join kind. A query
# that reads both sides is the pair dependent shape and has no plan here yet, so it is not in this
# file.
#
# Every expectation was taken off the pinned DuckDB and not out of rudb.

statement ok
CREATE TABLE pair_l(a INTEGER, x INTEGER);

statement ok
CREATE TABLE pair_r(b INTEGER, y INTEGER);

statement ok
CREATE TABLE pair_s(a INTEGER, b INTEGER);

statement ok
INSERT INTO pair_l VALUES (1, 10), (1, 11), (2, 20), (3, 30);

statement ok
INSERT INTO pair_r VALUES (10, 100), (20, 200), (30, 300), (40, 400);

statement ok
INSERT INTO pair_s VALUES (1, 10), (1, 20), (2, 20), (NULL, 30), (3, NULL);

# Reads neither side. The query is the same for every pair, it is true, and the join keeps the whole
# product of four left rows and four right ones.

query II
SELECT l.a, r.b FROM pair_l l LEFT JOIN pair_r r ON EXISTS (SELECT 1 FROM pair_s s WHERE s.a = 1) ORDER BY l.a, l.x, r.b;
----
1	10
1	20
1	30
1	40
1	10
1	20
1	30
1	40
2	10
2	20
2	30
2	40
3	10
3	20
3	30
3	40

# Reads the left side. Every value of a in pair_l has a row in pair_s, so again nothing is dropped,
# but the query can only be evaluated where the left rows are.

query II
SELECT l.a, r.b FROM pair_l l LEFT JOIN pair_r r ON EXISTS (SELECT 1 FROM pair_s s WHERE s.a = l.a) ORDER BY l.a, l.x, r.b;
----
1	10
1	20
1	30
1	40
1	10
1	20
1	30
1	40
2	10
2	20
2	30
2	40
3	10
3	20
3	30
3	40

# Reads the right side. pair_s holds 10, 20 and 30 and not 40, so the right row with 40 matches
# nothing and each left row keeps three partners.

query II
SELECT l.a, r.b FROM pair_l l LEFT JOIN pair_r r ON EXISTS (SELECT 1 FROM pair_s s WHERE s.b = r.b) ORDER BY l.a, l.x, r.b;
----
1	10
1	20
1	30
1	10
1	20
1	30
2	10
2	20
2	30
3	10
3	20
3	30

# The right side dropping out of a left join still pads, which is what says the query was evaluated
# in the right input and did not filter the left rows away with it.

query II
SELECT l.a, r.b FROM pair_l l LEFT JOIN pair_r r ON r.b = l.x AND EXISTS (SELECT 1 FROM pair_s s WHERE s.b = r.b) ORDER BY l.a, l.x, r.b;
----
1	10
1	NULL
2	20
3	30

# An IN, where the left hand side of the comparison reads the left and the body reads nothing. The
# comparison is carried by the join rather than by the condition, so it counts as a read too.

query II
SELECT l.a, r.b FROM pair_l l LEFT JOIN pair_r r ON l.a IN (SELECT s.a FROM pair_s s) ORDER BY l.a, l.x, r.b;
----
1	10
1	20
1	30
1	40
1	10
1	20
1	30
1	40
2	10
2	20
2	30
2	40
3	10
3	20
3	30
3	40

# A scalar query, which is a single join and not a mark join, correlated to the left.

query II
SELECT l.a, r.b FROM pair_l l JOIN pair_r r ON r.b = (SELECT max(s.b) FROM pair_s s WHERE s.a = l.a) ORDER BY l.a, l.x, r.b;
----
1	20
1	20
2	20

# The same right side query over an inner join.

query II
SELECT l.a, r.b FROM pair_l l INNER JOIN pair_r r ON EXISTS (SELECT 1 FROM pair_s s WHERE s.b = r.b) ORDER BY l.a, l.x, r.b;
----
1	10
1	20
1	30
1	10
1	20
1	30
2	10
2	20
2	30
3	10
3	20
3	30

# A right join, where the padded side is the one the query does not read.

query II
SELECT l.a, r.b FROM pair_l l RIGHT JOIN pair_r r ON EXISTS (SELECT 1 FROM pair_s s WHERE s.a = l.a) ORDER BY l.a, l.x, r.b;
----
1	10
1	20
1	30
1	40
1	10
1	20
1	30
1	40
2	10
2	20
2	30
2	40
3	10
3	20
3	30
3	40

# A full join, where both sides pad and the right row with 40 comes back on its own.

query II
SELECT l.a, r.b FROM pair_l l FULL JOIN pair_r r ON EXISTS (SELECT 1 FROM pair_s s WHERE s.b = r.b) ORDER BY l.a, l.x, r.b;
----
1	10
1	20
1	30
1	10
1	20
1	30
2	10
2	20
2	30
3	10
3	20
3	30
NULL	40

# A negated query, which is an anti mark and not a semi one.

query II
SELECT l.a, r.b FROM pair_l l LEFT JOIN pair_r r ON NOT EXISTS (SELECT 1 FROM pair_s s WHERE s.b = r.b) ORDER BY l.a, l.x, r.b;
----
1	40
1	40
2	40
3	40

# An uncorrelated aggregate, which is one row that every pair compares against.

query II
SELECT l.a, r.b FROM pair_l l JOIN pair_r r ON r.b > (SELECT count(*) FROM pair_s s) ORDER BY l.a, l.x, r.b;
----
1	10
1	20
1	30
1	40
1	10
1	20
1	30
1	40
2	10
2	20
2	30
2	40
3	10
3	20
3	30
3	40

# A quantified comparison whose left hand side reads the right and whose body reads neither.

query II
SELECT l.a, r.b FROM pair_l l LEFT JOIN pair_r r ON r.b = ANY (SELECT s.b FROM pair_s s WHERE s.a = 1) ORDER BY l.a, l.x, r.b;
----
1	10
1	20
1	10
1	20
2	10
2	20
3	10
3	20

statement ok
DROP TABLE pair_s;

statement ok
DROP TABLE pair_r;

statement ok
DROP TABLE pair_l;
