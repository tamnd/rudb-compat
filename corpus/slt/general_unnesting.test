# name: corpus/slt/general_unnesting.test
# description: correlated subqueries with no recognised shape unnest through a domain
# group: [smoke]

statement ok
CREATE TABLE unnest_outer(k INTEGER, t VARCHAR);

statement ok
INSERT INTO unnest_outer VALUES (1, 'a'), (2, 'b'), (3, NULL), (NULL, 'd');

statement ok
CREATE TABLE unnest_inner(k INTEGER, w INTEGER, s VARCHAR);

statement ok
INSERT INTO unnest_inner VALUES (1, 100, 'x'), (1, 200, 'y'), (2, 300, 'x'), (NULL, 400, 'z');

# A DISTINCT between the correlated filter and the aggregate. The distinct is per outer row, so the
# outer key that matched two inner rows with two different s values answers 2.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT DISTINCT s FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	2
2	1
3	0
NULL	0

# A projection between the filter and the aggregate.
query II rowsort
SELECT k, (SELECT max(w) FROM (SELECT w * 2 AS w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	400
2	600
3	NULL
NULL	NULL

# A join inside the subquery.
query II rowsort
SELECT k, (SELECT count(*) FROM unnest_inner JOIN unnest_outer AS p ON p.k = unnest_inner.k WHERE unnest_inner.k = unnest_outer.k) AS c FROM unnest_outer;
----
1	2
2	1
3	0
NULL	0

# A cross product inside the subquery, with only one of the two sides correlated.
query II rowsort
SELECT k, (SELECT count(*) FROM unnest_inner, unnest_outer AS p WHERE unnest_inner.k = unnest_outer.k AND p.k = 1) AS c FROM unnest_outer;
----
1	2
2	1
3	0
NULL	0

# A left join inside the subquery, whose padding rows still count.
query II rowsort
SELECT k, (SELECT count(*) FROM unnest_inner LEFT JOIN unnest_outer AS p ON p.k = unnest_inner.w WHERE unnest_inner.k = unnest_outer.k) AS c FROM unnest_outer;
----
1	2
2	1
3	0
NULL	0

# A sort inside the subquery, which changes nothing about what is aggregated over it.
query II rowsort
SELECT k, (SELECT sum(w) FROM (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k ORDER BY w) AS x) AS c FROM unnest_outer;
----
1	300
2	300
3	NULL
NULL	NULL

# A grouped aggregate inside the subquery, where the grouping is per outer row and not over the
# whole inner side.
query II rowsort
SELECT k, (SELECT sum(n) FROM (SELECT s, count(*) AS n FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k GROUP BY s) AS x) AS c FROM unnest_outer;
----
1	2
2	1
3	NULL
NULL	NULL

# The count bug. Grouping the inner side by the domain drops an outer key whose share of the inner
# side is empty, and a count over no rows is 0 and not a missing row.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	2
2	1
3	0
NULL	0

# The same shape with a sum, whose answer over no rows is null and needs no repair.
query II rowsort
SELECT k, (SELECT sum(w) FROM (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	300
2	300
3	NULL
NULL	NULL

# An IN test against a subquery with a DISTINCT in it.
query I rowsort
SELECT k FROM unnest_outer WHERE k IN (SELECT DISTINCT k FROM unnest_inner WHERE unnest_inner.w > 150);
----
1
2

# An EXISTS and its negation over the same correlation.
query I rowsort
SELECT k FROM unnest_outer WHERE EXISTS (SELECT 1 FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k);
----
1
2

query I rowsort
SELECT k FROM unnest_outer WHERE NOT EXISTS (SELECT 1 FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k);
----
3
NULL

# A window inside the subquery, which is numbered per outer row and not across all of them at once.
# The outer key with two matches answers 2 and the one with a single match answers 1.
query II rowsort
SELECT k, (SELECT max(r) FROM (SELECT row_number() OVER (ORDER BY w) AS r FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	2
2	1
3	NULL
NULL	NULL

# A window with an empty OVER, whose sum is over one outer row's matches rather than over the lot.
query II rowsort
SELECT k, (SELECT max(t) FROM (SELECT sum(w) OVER () AS t FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	300
2	300
3	NULL
NULL	NULL

# A window that already partitions by a column of its own, which still partitions by it.
query II rowsort
SELECT k, (SELECT max(r) FROM (SELECT rank() OVER (PARTITION BY s ORDER BY w) AS r FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	1
2	1
3	NULL
NULL	NULL

# A window with a frame written out, since the frame bounds are rewritten along with everything else.
query II rowsort
SELECT k, (SELECT max(t) FROM (SELECT sum(w) OVER (ORDER BY w ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS t FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	300
2	300
3	NULL
NULL	NULL

# The same window written as a LATERAL entry, which is the same rewrite reached the other way.
query II rowsort
SELECT o.k, v.r FROM unnest_outer AS o, LATERAL (SELECT row_number() OVER (ORDER BY w) AS r FROM unnest_inner WHERE unnest_inner.k = o.k) AS v;
----
1	1
1	2
2	1

# A limit inside the subquery, which is one row per outer row and not one row out of all of them.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k LIMIT 1) AS x) AS c FROM unnest_outer;
----
1	1
2	1
3	0
NULL	0

# A top N, which is the top thing per group and is the reason the rule is worth having.
query II rowsort
SELECT k, (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k ORDER BY w DESC LIMIT 1) AS c FROM unnest_outer;
----
1	200
2	300
3	NULL
NULL	NULL

# An offset with a count. Key 2 has one match, so skipping one leaves it nothing, which is what says
# the offset was counted inside that outer row's matches rather than over the whole inner side.
query II rowsort
SELECT k, (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k ORDER BY w LIMIT 1 OFFSET 1) AS c FROM unnest_outer;
----
1	200
2	NULL
3	NULL
NULL	NULL

# An offset with no count, which keeps everything after it.
query II rowsort
SELECT k, (SELECT sum(w) FROM (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k ORDER BY w OFFSET 1) AS x) AS c FROM unnest_outer;
----
1	200
2	NULL
3	NULL
NULL	NULL

# An offset past the end of every outer row's matches.
query II rowsort
SELECT k, (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k ORDER BY w LIMIT 1 OFFSET 5) AS c FROM unnest_outer;
----
1	NULL
2	NULL
3	NULL
NULL	NULL

# A LATERAL entry with a limit of two, which is two rows for the left row that has two matches.
query II rowsort
SELECT o.k, v.w FROM unnest_outer AS o, LATERAL (SELECT w FROM unnest_inner WHERE unnest_inner.k = o.k ORDER BY w LIMIT 2) AS v;
----
1	100
1	200
2	300

# The same as a LEFT JOIN LATERAL, where the left rows with no match are padded rather than dropped.
query II rowsort
SELECT o.k, v.w FROM unnest_outer AS o LEFT JOIN LATERAL (SELECT w FROM unnest_inner WHERE unnest_inner.k = o.k ORDER BY w LIMIT 1) AS v ON true;
----
1	100
2	300
3	NULL
NULL	NULL

statement ok
CREATE TABLE unnest_other(k INTEGER, w INTEGER);

statement ok
INSERT INTO unnest_other VALUES (1, 200), (1, 500), (2, 300), (3, 700);

# A UNION ALL of two correlated sides. Nothing is removed, so the outer key with two matches on one
# side and two on the other answers 4.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k UNION ALL SELECT w FROM unnest_other WHERE unnest_other.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	4
2	2
3	1
NULL	0

# The same with a UNION, which is the record that says the deduplication happens inside one outer row.
# The outer key 1 has 100 and 200 on one side and 200 and 500 on the other, so 200 is dropped once and
# the answer is 3 rather than 4.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k UNION SELECT w FROM unnest_other WHERE unnest_other.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	3
2	1
3	1
NULL	0

# A right side that asks nothing about the outer row. The outer keys with no match still answer 1,
# because the constant is there for every outer row.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k UNION SELECT 100) AS x) AS c FROM unnest_outer;
----
1	2
2	2
3	1
NULL	1

# An EXCEPT. The outer key 1 keeps 100 and loses 200 to the other side, and the outer key 2 has its
# only match subtracted, so it answers 0 rather than 1.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k EXCEPT SELECT w FROM unnest_other WHERE unnest_other.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	1
2	0
3	0
NULL	0

# An INTERSECT, which keeps the rows the EXCEPT above drops.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k INTERSECT SELECT w FROM unnest_other WHERE unnest_other.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	1
2	1
3	0
NULL	0

# An EXCEPT ALL rather than an EXCEPT, which subtracts by count rather than by membership.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k EXCEPT ALL SELECT w FROM unnest_other WHERE unnest_other.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	1
2	0
3	0
NULL	0

# Reading the rows rather than counting them, so a wrong answer shows up as a wrong total and not
# only as a wrong number of rows.
query II rowsort
SELECT k, (SELECT sum(w) FROM (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k UNION SELECT 100) AS x) AS c FROM unnest_outer;
----
1	300
2	400
3	100
NULL	100

# A right side that reads the whole other table and asks nothing about the outer row. The four rows it
# always contributes are on top of whatever the correlated side found.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k UNION ALL SELECT w FROM unnest_other) AS x) AS c FROM unnest_outer;
----
1	6
2	5
3	4
NULL	4

# Two columns rather than one, which is the record that says the sides are lined up by position and
# the domain column did not land in the middle of them.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT k, w FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k UNION ALL SELECT k, w FROM unnest_other WHERE unnest_other.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	4
2	2
3	1
NULL	0

# A UNION of two VARCHAR sides, one of which answers a single NULL for the outer key 3. A UNION treats
# two NULLs as the same row, so that outer key answers 1 and not 0.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT s FROM unnest_inner WHERE unnest_inner.k = unnest_outer.k UNION SELECT t FROM unnest_outer AS p WHERE p.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	3
2	2
3	1
NULL	0

# The same shape as a LATERAL entry, where the rows come out rather than being counted.
query II rowsort
SELECT o.k, v.w FROM unnest_outer AS o, LATERAL (SELECT w FROM unnest_inner WHERE unnest_inner.k = o.k UNION SELECT 999) AS v;
----
1	100
1	200
1	999
2	300
2	999
3	999
NULL	999

# A right join whose correlated side is the one it does not preserve. Every row of the right side
# survives whatever the outer row is, so every outer key answers 4.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT unnest_other.w FROM unnest_inner RIGHT JOIN unnest_other ON unnest_inner.w = unnest_other.w AND unnest_inner.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	4
2	4
3	4
NULL	4

# The same join counting the padded column instead of the rows, which is what says the matching was
# done per outer row and not once for all of them.
query II rowsort
SELECT k, (SELECT count(unnest_inner.w) FROM unnest_inner RIGHT JOIN unnest_other ON unnest_inner.w = unnest_other.w AND unnest_inner.k = unnest_outer.k) AS c FROM unnest_outer;
----
1	1
2	1
3	0
NULL	0

# A right join whose correlated side is the one it preserves, which is the side that already carries
# the domain and so needs nothing added to the other one.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT unnest_inner.w FROM unnest_other RIGHT JOIN unnest_inner ON unnest_inner.w = unnest_other.w AND unnest_inner.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	4
2	4
3	4
NULL	4

# A full join with the correlation on its left side. Both sides are preserved, so the outer keys with
# no match at all answer 8, which is four rows from each side, and the ones with a match answer 7.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT unnest_inner.w FROM unnest_inner FULL JOIN unnest_other ON unnest_inner.w = unnest_other.w AND unnest_inner.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	7
2	7
3	8
NULL	8

# The same with the correlation on the right side instead, which is a different decision about which
# sides have to carry the domain and the same answer.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT unnest_inner.w FROM unnest_inner FULL JOIN unnest_other ON unnest_inner.w = unnest_other.w AND unnest_other.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	7
2	7
3	8
NULL	8

# And with both sides reading the outer row.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT unnest_inner.w FROM unnest_inner FULL JOIN unnest_other ON unnest_inner.w = unnest_other.w AND unnest_inner.k = unnest_outer.k AND unnest_other.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	7
2	7
3	8
NULL	8

# A full join with no join key at all, where the only condition is the correlated one. The outer key
# with two matching inner rows answers 10 and the ones with none answer 8.
query II rowsort
SELECT k, (SELECT count(*) FROM (SELECT unnest_inner.w FROM unnest_inner FULL JOIN unnest_other ON unnest_inner.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	10
2	7
3	8
NULL	8

# Counting each side's own column over a full join. Both answer 4, because both sides are preserved
# and every row of each is there once per outer row whether it matched or not.
query II rowsort
SELECT k, (SELECT count(unnest_inner.w) FROM unnest_inner FULL JOIN unnest_other ON unnest_inner.w = unnest_other.w AND unnest_inner.k = unnest_outer.k) AS c FROM unnest_outer;
----
1	4
2	4
3	4
NULL	4

query II rowsort
SELECT k, (SELECT count(unnest_other.w) FROM unnest_inner FULL JOIN unnest_other ON unnest_inner.w = unnest_other.w AND unnest_inner.k = unnest_outer.k) AS c FROM unnest_outer;
----
1	4
2	4
3	4
NULL	4

# Reading the rows rather than counting them.
query II rowsort
SELECT k, (SELECT sum(x.w) FROM (SELECT unnest_other.w FROM unnest_inner FULL JOIN unnest_other ON unnest_inner.w = unnest_other.w AND unnest_inner.k = unnest_outer.k) AS x) AS c FROM unnest_outer;
----
1	1700
2	1700
3	1700
NULL	1700

# A full join as a LATERAL entry, where every row comes out and is labelled with the outer key it
# belongs to. This is the record that says the padded rows of each side went to the right outer row,
# since that is the whole question a full join asks and a count would hide getting it wrong.
query III rowsort
SELECT o.k, v.a, v.b FROM unnest_outer AS o, LATERAL (SELECT unnest_inner.w, unnest_other.w FROM unnest_inner FULL JOIN unnest_other ON unnest_inner.w = unnest_other.w AND unnest_inner.k = o.k) AS v(a, b);
----
1	100	NULL
1	200	200
1	300	NULL
1	400	NULL
1	NULL	300
1	NULL	500
1	NULL	700
2	100	NULL
2	200	NULL
2	300	300
2	400	NULL
2	NULL	200
2	NULL	500
2	NULL	700
3	100	NULL
3	200	NULL
3	300	NULL
3	400	NULL
3	NULL	200
3	NULL	300
3	NULL	500
3	NULL	700
NULL	100	NULL
NULL	200	NULL
NULL	300	NULL
NULL	400	NULL
NULL	NULL	200
NULL	NULL	300
NULL	NULL	500
NULL	NULL	700
