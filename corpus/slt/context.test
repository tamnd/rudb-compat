# name: corpus/slt/context.test
# description: the fourteen names that answer about the connection rather than about the query
# group: [smoke]

# Almost nothing in this file prints a value, because the clock moves and a record that pinned an
# instant would fail a second after it was written. What holds still is the type of each answer, the
# agreement between the spellings of one answer, and the rule that one statement sees one instant,
# and those are what is written down here. Every expectation was read off the pinned DuckDB first.

# There are eight answers and fourteen names for them. Ten take a bare keyword, fourteen take a
# call, and the five that only take one of the two spellings are upstream's own split rather than a
# gap here, which the two errors at the foot of this file hold in place.

query TTTTTT
SELECT typeof(now()), typeof(current_timestamp), typeof(get_current_timestamp()), typeof(transaction_timestamp()), typeof(localtimestamp), typeof(current_localtimestamp());
----
TIMESTAMP WITH TIME ZONE	TIMESTAMP WITH TIME ZONE	TIMESTAMP WITH TIME ZONE	TIMESTAMP WITH TIME ZONE	TIMESTAMP	TIMESTAMP

query TTTTTT
SELECT typeof(current_date), typeof(today()), typeof(current_time), typeof(get_current_time()), typeof(localtime), typeof(current_localtime());
----
DATE	DATE	TIME WITH TIME ZONE	TIME WITH TIME ZONE	TIME	TIME

# The four that name something the catalog knows, and the three that name the user. Neither engine
# has users, and both answer a name rather than an empty string, because a client that asks who it
# is connected as wants something to print.

query TTTTTTT
SELECT current_schema, current_schema(), current_catalog, current_database(), current_user, session_user, user;
----
main	main	memory	memory	duckdb	duckdb	duckdb

# One instant per statement, whatever spells it and however many rows read it. That is what upstream
# reports as CONSISTENT_WITHIN_QUERY in the stability column of duckdb_functions(), and it is the
# one property of these that a test can hold to without knowing what time it is.

query TTTT
SELECT now() = current_timestamp, now() = transaction_timestamp(), now() = get_current_timestamp(), today() = current_date;
----
true	true	true	true

query I
SELECT count(DISTINCT n) FROM (SELECT now() AS n FROM range(3));
----
1

query TT
SELECT now() > TIMESTAMP '2024-01-01', current_date > DATE '2024-01-01';
----
true	true

# A column of the same name beats the keyword. That is the reason the scope is asked about the word
# before anything folds, and it was measured for all ten of the bare spellings.

statement ok
CREATE TABLE context (current_date VARCHAR, current_user VARCHAR, "user" VARCHAR);

statement ok
INSERT INTO context VALUES ('a', 'b', 'c');

query TTT
SELECT current_date, current_user, user FROM context;
----
a	b	c

# And a name two tables both carry is still the ambiguity error rather than the constant, which is
# the half of that rule that a fallback after a failed lookup would have got wrong.

statement error
SELECT current_date FROM context, context AS again;
----
Ambiguous reference to column name "current_date"

# A zoned value keeps its zone through arithmetic. now() is the first way a query gets one of these
# without writing the type out, so every operator that takes a timestamp has to know the zoned kind,
# and what each one answers is upstream's answer rather than a rule invented here.

query TTTT
SELECT typeof(now() + INTERVAL 1 DAY), typeof(INTERVAL 1 DAY + now()), typeof(now() - INTERVAL 1 DAY), typeof(now() + NULL);
----
TIMESTAMP WITH TIME ZONE	TIMESTAMP WITH TIME ZONE	TIMESTAMP WITH TIME ZONE	TIMESTAMP WITH TIME ZONE

query TTTT
SELECT typeof(now() - now()), typeof(now() - TIMESTAMP '2020-01-01'), typeof(now() - DATE '2020-01-01'), typeof(age(now(), now()));
----
INTERVAL	INTERVAL	INTERVAL	INTERVAL

query TTTT
SELECT typeof(date_part('year', now())), typeof(date_trunc('day', now())), typeof(current_time + INTERVAL 1 HOUR), typeof(current_date + current_time);
----
BIGINT	TIMESTAMP WITH TIME ZONE	TIME WITH TIME ZONE	TIMESTAMP WITH TIME ZONE

# The values those operators land on, written as comparisons rather than as printed timestamps so
# that the record says nothing about which zone the session is in. The month added to the last day
# of January clamps to the end of February, the same as it does without a zone.

query TTT
SELECT date_trunc('day', TIMESTAMPTZ '2020-01-02 03:04:05') = TIMESTAMPTZ '2020-01-02 00:00:00', TIMESTAMPTZ '2020-01-31 10:00:00' + INTERVAL 1 MONTH = TIMESTAMPTZ '2020-02-29 10:00:00', TIMESTAMPTZ '2020-01-02 00:00:00' - TIMESTAMPTZ '2020-01-01 00:00:00' = INTERVAL 1 DAY;
----
true	true	true

# The five names that take one spelling and not the other. current_database is a function with no
# keyword behind it and current_timestamp is a keyword with no function behind it, so each of these
# is an error on both engines and neither is a hole in the table.

statement error
SELECT current_database;
----
Referenced column "current_database" not found in FROM clause!

statement error
SELECT current_timestamp();
----
Scalar Function with name current_timestamp does not exist!

# A call with arguments is not one of these and reaches the function table, which carries a row per
# name so that the answer is the arity error rather than a missing function. That is the only thing
# those rows are for, since the binder folds every call that does fit.

statement error
SELECT now(1);
----
No function matches the given name and argument types 'now(INTEGER)'

# All fourteen are listed, which is where a client looks to find out what the connection offers. The
# count is of the distinct names and not of the rows, because upstream has two rows for
# current_schema and two for current_database, a scalar and a macro with the same name, and what is
# worth holding still is that the name is there rather than how many ways it is there.

query I
SELECT count(DISTINCT function_name) FROM duckdb_functions() WHERE function_name IN ('now', 'today', 'get_current_timestamp', 'get_current_time', 'transaction_timestamp', 'current_localtime', 'current_localtimestamp', 'current_date', 'current_schema', 'current_database', 'current_catalog', 'current_user', 'session_user', 'user');
----
14
