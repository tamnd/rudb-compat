# name: corpus/slt/correlated_scalar_subquery.test
# description: correlated scalar filters and aggregates unnest to set-based single joins
# group: [smoke]

query II rowsort
SELECT k, (SELECT count(o.k) FROM (VALUES (10), (20)) i(x)) FROM (VALUES (1), (NULL)) o(k);
----
1	2
NULL	0

query II rowsort
SELECT k, (SELECT sum(o.k) FROM (VALUES (10), (20)) i(x)) FROM (VALUES (1), (NULL)) o(k);
----
1	2
NULL	NULL

statement ok
CREATE TABLE empty_aggregate_source(x INTEGER);

query I
SELECT (SELECT count(o.k) FROM empty_aggregate_source) FROM (VALUES (1)) o(k);
----
0

query II rowsort
SELECT k, (SELECT o.k + 1) FROM (VALUES (1), (1), (2), (NULL)) o(k);
----
1	2
1	2
2	3
NULL	NULL

query II rowsort
SELECT k, (SELECT o.k + x FROM (VALUES (10)) i(x)) FROM (VALUES (1), (2)) o(k);
----
1	11
2	12

statement ok
CREATE TABLE empty_scalar_source(x INTEGER);

query II rowsort
SELECT k, (SELECT o.k + x FROM empty_scalar_source) FROM (VALUES (1), (2)) o(k);
----
1	NULL
2	NULL

statement error
SELECT (SELECT o.k + x FROM (VALUES (10), (20)) i(x)) FROM (VALUES (1)) o(k);
----
More than one row returned by a subquery used as an expression - scalar subqueries can only return a single row.

query II rowsort
SELECT k, (SELECT value FROM (VALUES (1, 10), (2, 20)) i(k, value) WHERE i.k = o.k) FROM (VALUES (1), (2), (3), (NULL)) o(k);
----
1	10
2	20
3	NULL
NULL	NULL

query II rowsort
SELECT k, (SELECT count(*) FROM (VALUES (1), (2), (3)) i(x) WHERE i.x < o.k) FROM (VALUES (1), (2), (4)) o(k);
----
1	0
2	1
4	3

query II rowsort
SELECT k, (SELECT sum(value) FROM (VALUES (1, 10), (2, 20), (3, 30)) i(x, value) WHERE i.x < o.k) FROM (VALUES (1), (2), (4)) o(k);
----
1	NULL
2	10
4	60

query II rowsort
SELECT k, (SELECT count(*) FROM (VALUES (10), (20)) i(x) WHERE o.k > 1) FROM (VALUES (1), (2)) o(k);
----
1	0
2	2

query I
SELECT (SELECT count(*) FROM (VALUES (NULL), (1)) i(x) WHERE i.x IS DISTINCT FROM o.k) FROM (VALUES (NULL)) o(k);
----
1

query II rowsort
SELECT k, (SELECT count(*) FROM (VALUES (1, 10), (1, NULL), (2, 5), (NULL, 40)) i(k, value) WHERE i.k = o.k AND value > 5) FROM (VALUES (1), (2), (3), (NULL)) o(k);
----
1	1
2	0
3	0
NULL	0

query II rowsort
SELECT k, (SELECT count(1) FROM (VALUES (1), (1), (2)) i(k) WHERE i.k = o.k) FROM (VALUES (1), (3)) o(k);
----
1	2
3	0

query II rowsort
SELECT k, (SELECT value FROM (VALUES (1, 10), (1, 20)) i(k, value) WHERE i.k = o.k AND value > 10) FROM (VALUES (1), (2)) o(k);
----
1	20
2	NULL

statement error
SELECT (SELECT value FROM (VALUES (1, 10), (1, 20)) i(k, value) WHERE i.k = o.k) FROM (VALUES (1)) o(k);
----
More than one row returned by a subquery used as an expression - scalar subqueries can only return a single row.

query II rowsort
SELECT k, (SELECT sum(value) FROM (VALUES (1, 10), (1, 20), (2, 5), (NULL, 40)) i(k, value) WHERE i.k = o.k AND value > 5) FROM (VALUES (1), (2), (3), (NULL)) o(k);
----
1	30
2	NULL
3	NULL
NULL	NULL

# A select list that reads the outer row, over a filter that reads it with an equality. The rule
# that turns a correlated filter into an ordinary join cannot take these, because the projection it
# would move to the right side of that join reads a column of the left side. It used to take them
# anyway and they came back as an internal error about a column not being in a schema, which is
# rudb#993. The general domain rule answers them.

query II rowsort
SELECT k, (SELECT o.k FROM (VALUES (1, 10), (2, 20)) i(k, v) WHERE i.k = o.k) FROM (VALUES (1), (2), (3), (NULL)) o(k);
----
1	1
2	2
3	NULL
NULL	NULL

query II rowsort
SELECT k, (SELECT o.k + i.v FROM (VALUES (1, 10), (2, 20)) i(k, v) WHERE i.k = o.k) FROM (VALUES (1), (2), (3), (NULL)) o(k);
----
1	11
2	22
3	NULL
NULL	NULL

# A second outer column, which the correlation does not read, so the outer row is used twice over.

query III rowsort
SELECT k, t, (SELECT o.t FROM (VALUES (1, 10), (2, 20)) i(k, v) WHERE i.k = o.k) FROM (VALUES (1, 'a'), (2, 'b'), (3, NULL)) o(k, t);
----
1	a	a
2	b	b
3	NULL	NULL

# A local predicate beside the correlated one, so the filter has a part that stays where it is.

query II rowsort
SELECT k, (SELECT o.k FROM (VALUES (1, 10), (1, 20), (2, 20)) i(k, v) WHERE i.k = o.k AND i.v = 20) FROM (VALUES (1), (2), (3), (NULL)) o(k);
----
1	1
2	2
3	NULL
NULL	NULL

# The same tables with an aggregate instead, where the projection reads nothing outer, so the rule
# does still take it. This is the record that says the guard is about the projection and not about
# the filter.

query II rowsort
SELECT k, (SELECT max(i.v) FROM (VALUES (1, 10), (1, 20), (2, 20)) i(k, v) WHERE i.k = o.k) FROM (VALUES (1), (2), (3), (NULL)) o(k);
----
1	20
2	20
3	NULL
NULL	NULL
