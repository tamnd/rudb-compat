# name: corpus/slt/nested_subquery_outer_reference.test
# description: a subquery inside a correlated subquery that reads a table the query two levels out joins
# group: [subquery]

# A name inside the innermost query that resolves past the query in the middle belongs to the query
# above that one. The query in the middle is not correlated by it and should not be: it reads nothing
# of the outer row itself, and the domain the outer query builds is pushed down through it to
# wherever the column is actually read.
#
# What made this a file rather than one record is where the reference ends up in the plan. A rule
# that reads the correlation out of a filter or a projection does not see a column read anywhere
# else, so it builds a domain over the columns it did see and plants the relation, other reference
# and all, under a join with that domain, where the other table is not in scope. Every rule that
# reads its keys out of one place had it, so there is a record per rule here: the existence test, the
# scalar aggregate, the scalar count, the IN list and the anti join.
#
# Every expectation was taken off the pinned DuckDB and not out of rudb.

statement ok
CREATE TABLE nest_outer (k INTEGER, t VARCHAR);

statement ok
CREATE TABLE nest_inner (k INTEGER, w INTEGER, s VARCHAR);

statement ok
INSERT INTO nest_outer VALUES (1, 'a'), (2, 'b'), (3, NULL), (NULL, 'd');

statement ok
INSERT INTO nest_inner VALUES (1, 100, 'x'), (1, 200, 'y'), (2, 300, 'x'), (NULL, 400, 'z');

# The smallest shape. The innermost query selects a column of the far side of the join and nothing
# reads the value, so the whole of the nested test is whether one row comes back, which it does.

query I
SELECT o1.k FROM nest_outer o1 JOIN nest_outer o2 ON (o1.k = o2.k) WHERE EXISTS (SELECT 1 FROM nest_inner i WHERE o1.k < 3 AND EXISTS (SELECT o2.k)) ORDER BY o1.k;
----
1
2

# The same with the column tested rather than selected, so no later pass can decide the projection is
# unread and delete the reference on its way past. The test is a real one here, which is why the
# first outer row drops out.

query I
SELECT o1.k FROM nest_outer o1 JOIN nest_outer o2 ON (o1.k = o2.k) WHERE EXISTS (SELECT 1 FROM nest_inner i WHERE o1.k < 3 AND EXISTS (SELECT 1 WHERE o2.k > 1)) ORDER BY o1.k;
----
2

# The nested test reads the middle query's own relation and the far side of the join at once, which
# is two different queries' columns in one predicate.

query I
SELECT o1.k FROM nest_outer o1 JOIN nest_outer o2 ON (o1.k = o2.k) WHERE EXISTS (SELECT 1 FROM nest_inner i WHERE o1.k < 3 AND EXISTS (SELECT 1 WHERE i.w > o2.k)) ORDER BY o1.k;
----
1
2

# The same correlation under a scalar aggregate. The middle query is correlated on o1.k through its
# own WHERE, so there is a domain to build and a relation to put under it.

query II
SELECT o1.k, (SELECT max(w) FROM nest_inner i WHERE i.k = o1.k AND EXISTS (SELECT 1 WHERE o2.k > 1)) AS c FROM nest_outer o1 JOIN nest_outer o2 ON (o1.k = o2.k) ORDER BY o1.k;
----
1	NULL
2	300
3	NULL

# Under a scalar count, which is a rule of its own because a count over an empty input is zero rather
# than NULL. The first and third outer rows are the empty input, and the nested test is what empties
# the first one.

query II
SELECT o1.k, (SELECT count(*) FROM nest_inner i WHERE i.k = o1.k AND EXISTS (SELECT 1 WHERE o2.k > 1)) AS c FROM nest_outer o1 JOIN nest_outer o2 ON (o1.k = o2.k) ORDER BY o1.k;
----
1	0
2	1
3	0

# Under an IN, which binds as a mark join and has a rule of its own as well.

query I
SELECT o1.k FROM nest_outer o1 JOIN nest_outer o2 ON (o1.k = o2.k) WHERE o1.k IN (SELECT i.k FROM nest_inner i WHERE i.w > o1.k AND EXISTS (SELECT 1 WHERE o2.k > 1)) ORDER BY o1.k;
----
2

# Under a NOT EXISTS, which is the anti join, so the rows this answers with are the ones the scalar
# count above answered zero for.

query I
SELECT o1.k FROM nest_outer o1 JOIN nest_outer o2 ON (o1.k = o2.k) WHERE NOT EXISTS (SELECT 1 FROM nest_inner i WHERE i.k = o1.k AND EXISTS (SELECT 1 WHERE o2.k > 1)) ORDER BY o1.k;
----
1
3

# Three levels rather than two, with the innermost query reading past both of the queries over it.

query I
SELECT o1.k FROM nest_outer o1 JOIN nest_outer o2 ON (o1.k = o2.k) WHERE EXISTS (SELECT 1 FROM nest_inner i1 WHERE i1.k = o1.k AND EXISTS (SELECT 1 FROM nest_inner i2 WHERE i2.w > i1.w AND EXISTS (SELECT 1 WHERE o2.k > 0))) ORDER BY o1.k;
----
1
2

# The far side of the join is the padded side of an outer join, so the column the innermost query
# reads is NULL for an outer row that matched nothing, and the test on it is NULL rather than false.

query I
SELECT o1.k FROM nest_outer o1 LEFT JOIN nest_outer o2 ON (o1.k = o2.k) WHERE EXISTS (SELECT 1 FROM nest_inner i WHERE i.k = o1.k AND EXISTS (SELECT 1 WHERE o2.k > 1)) ORDER BY o1.k;
----
2

# The shape where nothing reads the subquery's answer, which answered before the rules above learned
# to stand aside and answered by luck. Column pruning deletes a projection nobody reads, which
# deleted the reference, which happened to leave a valid plan behind. It is here to hold that line,
# since the fix must not depend on which pass ran first either.

query II
SELECT o1.k, (SELECT max(w) FROM nest_inner i WHERE i.k = o1.k AND EXISTS (SELECT o2.t)) AS c FROM nest_outer o1 JOIN nest_outer o2 ON (o1.k = o2.k) ORDER BY o1.k;
----
1	200
2	300
3	NULL

# The outer reference read from the select list of the query in the middle rather than from a
# predicate of it, which puts it beside an aggregate. This was held back from this file until rudb
# #1027, because a subquery anywhere in the select list of a grouped query was refused there.

query II
SELECT o1.k, (SELECT max(w) + (SELECT o2.k) FROM nest_inner i WHERE i.k = o1.k) AS c FROM nest_outer o1 JOIN nest_outer o2 ON (o1.k = o2.k) ORDER BY o1.k;
----
1	201
2	302
3	NULL
