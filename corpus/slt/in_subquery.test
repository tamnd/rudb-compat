# name: corpus/slt/in_subquery.test
# description: IN and NOT IN subqueries match the pinned engine
# group: [smoke]

query I
SELECT 1 IN (SELECT x FROM (VALUES (1), (2)) t(x));
----
1

query I
SELECT 3 IN (SELECT x FROM (VALUES (1), (2)) t(x));
----
0

query I
SELECT 3 IN (SELECT x FROM (VALUES (1), (NULL)) t(x));
----
NULL

query I
SELECT NULL IN (SELECT x FROM (VALUES (1), (2)) t(x));
----
NULL

query I
SELECT NULL IN (SELECT x FROM (VALUES (1)) t(x) WHERE false);
----
0

query I
SELECT 3 NOT IN (SELECT x FROM (VALUES (1), (NULL)) t(x));
----
NULL

query II rowsort
SELECT x, x IN (SELECT y FROM (VALUES (1), (3)) candidates(y)) FROM (VALUES (1), (2), (3)) outer_rows(x);
----
1	1
2	0
3	1

query I
SELECT 1 IN (SELECT '1');
----
1

query II rowsort
SELECT k, k IN (SELECT x FROM (VALUES (1), (2), (NULL)) i(x) WHERE i.x = o.k) FROM (VALUES (1), (3), (NULL)) o(k);
----
1	1
3	0
NULL	0

query I rowsort
SELECT k FROM (VALUES (1), (2), (3)) o(k) WHERE k NOT IN (SELECT x FROM (VALUES (1), (3)) i(x) WHERE i.x = o.k);
----
2

query II rowsort
SELECT g, 15 IN (SELECT value FROM (VALUES (1, 10), (1, NULL), (2, 20)) i(g, value) WHERE i.g = o.g) FROM (VALUES (1), (2), (3)) o(g);
----
1	NULL
2	0
3	0
