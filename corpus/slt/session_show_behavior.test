# name: corpus/slt/session_show_behavior.test
# description: session resolution of SHOW names as settings or tables
# group: [smoke]

query T
SHOW show_behavior;
----
AUTO

statement ok
CREATE TABLE demo(i INTEGER, s VARCHAR);

query TTTTTT
SHOW demo;
----
i	INTEGER	YES	NULL	NULL	NULL
s	VARCHAR	YES	NULL	NULL	NULL

statement ok
CREATE TABLE show_behavior(v INTEGER);

query TTTTTT
SHOW show_behavior;
----
v	INTEGER	YES	NULL	NULL	NULL

statement ok
SET show_behavior = 'setting';

query T
SHOW show_behavior;
----
setting

statement error
SHOW demo;
----
Setting with name "demo" does not exist

statement error
SHOW main.show_behavior;
----
Setting with name "main.show_behavior" does not exist

statement ok
SET show_behavior = 'TABLE';

query TTTTTT
SHOW demo;
----
i	INTEGER	YES	NULL	NULL	NULL
s	VARCHAR	YES	NULL	NULL	NULL

statement error
SHOW no_such_table;
----
Table with name no_such_table does not exist!

query T
SELECT current_setting('show_behavior');
----
TABLE

statement ok
RESET show_behavior;

query T
SELECT current_setting('show_behavior');
----
AUTO

statement error
SET show_behavior = 'bad';
----
Enum value: unrecognized value "bad" for enum "ShowBehaviorType"

query TTT
SELECT description, input_type, scope FROM duckdb_settings() WHERE name = 'show_behavior';
----
How SHOW resolves a bare identifier: 'auto' (describe a table if one exists, else a setting; deprecated), 'table' (always a table), or 'setting' (always a setting)	VARCHAR	GLOBAL
